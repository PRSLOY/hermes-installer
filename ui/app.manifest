<?xml version="1.0" encoding="utf-8"?>
<!-- Embedded into HermesSetup.exe by build-ui.ps1 (csc /win32manifest). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="HermesSetup.app"/>
  <!-- Keep asInvoker: the file name contains "Setup", and without an explicit level
       Windows installer detection would demand elevation for the whole wizard. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
  <!-- System-DPI aware: Windows no longer bitmap-stretches the window at 125/150 %;
       WinForms AutoScaleMode.Dpi scales geometry from the 96-DPI baseline and fonts render
       at the real DPI. Deliberately NOT PerMonitorV2: on .NET Framework 4.8 WinForms rescales
       on a monitor change only with an extra HermesSetup.exe.config entry, which a single
       shipped exe cannot rely on. A second monitor with another scale is stretched by Windows. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">system</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
